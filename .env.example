DART_API_KEY=your_dart_api_key_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here
POLL_INTERVAL_SEC=7
CORP_CLS=Y

# 뉴스 전용 채널/룸 (선택) — 설정하면 공시와 뉴스 알림이 분리된다. 미설정 시 같은 채널.
#DISCORD_NEWS_CHANNEL_ID=your_news_channel_id_here
#WEBEX_NEWS_ROOM_ID=your_news_room_id_here

# ── 뉴스 수집 ───────────────────────────────────────────────
# 기본 활성화 — 언론사 RSS를 키 없이 감시한다. 끄려면 false.
# 뉴스는 개별 속보로 즉시 발송하지 않는다. 신규 기사를 헤드라인 버퍼에 쌓아두고,
# 시황 리포트(아래 MARKET_REPORT_*)가 지난 1시간치를 읽어 "시장 상황·주도 종목" 분석 재료로 쓴다.
NEWS_ENABLED=true

# 네이버 검색 보완망 (선택) — 둘 다 설정하면 RSS에 없는 매체까지 커버
# 발급: https://developers.naver.com (검색 API 애플리케이션 등록)
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# 폴링 주기 — RSS는 무료·무제한이라 짧게, 네이버는 일 25,000회 한도라 길게
NEWS_RSS_POLL_INTERVAL_SEC=30
NEWS_POLL_INTERVAL_SEC=240

# 아래 키워드 그룹은 네이버/구글 검색의 검색어로만 쓰인다 (검색 커버리지를 넓혀 버퍼를 채운다).
NEWS_KEYWORDS=수주,공급계약,납품,우선협상대상자,기술수출,기술이전,라이선스,라이센스,FDA,EMA,임상,신약,품목허가,희귀의약품,무상증자,자사주,주식 소각,특별배당,특허,흑자전환,어닝서프라이즈,최대 실적,실적 호조,상한가,신고가,M&A,지분 인수,경영권 인수,증설,신사업,세계 최초,국내 최초,수혜,MOU,국책과제
NEWS_BAD_KEYWORDS=하한가,거래정지,상장폐지,압수수색,횡령,배임,유상증자,감자,파산,회생절차,부도,리콜,불성실공시,어닝쇼크,적자전환,영업정지,관리종목,분식회계,피소,패소,소송,적자,손실,화재,폭발,해킹,구속,기소
NEWS_MACRO_KEYWORDS=FOMC,기준금리,서킷브레이커,사이드카,비상계엄,호르무즈

# 버퍼 적재 전 잡음 컷 — 제목에 이 중 하나가 들어가면 버린다 (스포츠·연예 등). 비우면 컷 없음.
NEWS_EXCLUDE_KEYWORDS=

# RSS 피드 — "이름|URL" 콤마 구분 (미설정 시 검증된 기본 6개 피드 사용)
#NEWS_RSS_FEEDS=한국경제|https://www.hankyung.com/feed/finance,이데일리|http://rss.edaily.co.kr/stock_news.xml

# ── 장 흐름 분석 리포트 (LLM 요약) ──────────────────────────────
# KIS 거래대금·급등 데이터를 모아 LLM으로 한국어 요약을 만들어 N분마다 보낸다.
# KIS(KIS_APP_KEY/SECRET)가 설정돼 있어야 동작한다. 데이터는 코드가 집계하고 모델은 서술만 한다.
#
# 공급자 선택: gemini(클라우드·무료한도·렉없음, 권장) 또는 ollama(로컬·무료·PC부하).
LLM_PROVIDER=gemini
MARKET_REPORT_ENABLED=false
MARKET_REPORT_INTERVAL_MIN=60

# [gemini] Google AI Studio에서 무료 키 발급: https://aistudio.google.com/apikey
#   - 시간당 1건이라 무료 한도로 충분. 키 발급 후 아래에 넣고 MARKET_REPORT_ENABLED=true.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# [ollama] 로컬 LLM (LLM_PROVIDER=ollama 일 때만). 키 아님(로컬 무인증) — 주소·모델명.
#   준비: https://ollama.com/download 설치 → ollama pull exaone3.5:7.8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=exaone3.5:7.8b

# ── 공시 기반 자동매매 (Stage 1: 드라이런) ─────────────────────────
# "단일판매·공급계약" 호재에서 계약금액이 최근 매출액의 임계(%) 이상이면 진입 신호로 보고,
# 예산으로 몇 주를 샀을지·진입 후 손절/익절/장마감에 어떻게 청산됐을지를 실제 KIS 분봉으로 감시해
# 알림·로그로 남긴다. 드라이런은 실제 주문을 내지 않는다(전략 검증용). KIS(KIS_APP_KEY/SECRET) 필요.
AUTO_TRADE_ENABLED=false
# 실행 모드 — dryrun(모의 시뮬레이션, 실주문 없음). paper/live는 Stage2/3에서 지원 예정.
AUTO_TRADE_MODE=dryrun
# 1회 매수 예산(원) — 진입가로 나눠 정수 주식 수를 산정. 예산<1주(고가주)면 진입 생략.
AUTO_TRADE_BUDGET_WON=1000000
# 진입 임계 — 계약금액이 최근 매출액의 이 % 이상일 때만 매수.
AUTO_TRADE_MIN_SALES_RATIO=50
# 손절/익절(%) — 진입가 대비. 손절 -2%, 익절 +5%.
AUTO_TRADE_STOP_LOSS_PCT=2
AUTO_TRADE_TAKE_PROFIT_PCT=5
# 동시 보유 종목 상한 / 감시 주기(초) / 장마감 강제청산 시각(HH:mm).
AUTO_TRADE_MAX_POSITIONS=5
AUTO_TRADE_MONITOR_SEC=30
AUTO_TRADE_EOD_CLOSE=15:20
# (Stage2 실주문용 자리 — Stage1 미사용) 계좌번호(CANO 8자리) / 상품코드(ACNT_PRDT_CD, 보통 01).
#AUTO_TRADE_CANO=
#AUTO_TRADE_ACNT_PRDT_CD=01
